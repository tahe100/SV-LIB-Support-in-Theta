(set-logic QF_LRA)
(define-proc
  add
  ((x0 asdf1) (y0 asdf2))
  ((x asdf4))
  ((y asdf3))
  (! (sequence
       (assign (x x0) (y y0))
       (! (while
            (<= 0 y)
            (assign
              (x (+ x 1))
              (y (- y 1))))
        :tag while-loop))
    :tag proc-add))
