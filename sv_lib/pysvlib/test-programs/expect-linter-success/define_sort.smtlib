(set-logic LIA)

; Declare sorts with different arities
(declare-sort List 1)
(declare-sort Tree 1)
(declare-sort Pair 2)

; Use declared sorts in variable declarations
(declare-const my_list (List Int))
(declare-const my_tree (Tree Int))
(declare-const my_pair (Pair Int Bool))
