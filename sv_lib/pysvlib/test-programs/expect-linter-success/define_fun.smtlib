(set-logic LIA)

; Valid function definitions with different complexities
(define-fun double ((x Int)) Int (* 2 x))
(define-fun is_positive ((x Int)) Bool (> x 0))
(define-fun max ((a Int) (b Int)) Int (ite (>= a b) a b))

; Use defined functions
(declare-const x Int)
(declare-const y Int)
(assert (= (double x) (* 2 x)))
(assert (is_positive (max x y)))
