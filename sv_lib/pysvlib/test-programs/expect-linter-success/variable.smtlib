(set-logic LIA)

; Declare variables
(declare-const x Int)
(declare-const y Int)
(declare-const flag Bool)

; Valid variable references
(assert (= x y))
(assert (= (+ x y) 0))
(assert (and flag (= x 1)))

; Variables in complex expressions
(assert (= (* x y) (+ x y)))
(assert (ite flag x y))
