; Valid logic declarations
(set-logic LIA)    ; Linear Integer Arithmetic
(set-logic QF_LIA) ; Quantifier-free LIA
(set-logic LRA)    ; Linear Real Arithmetic
(set-logic QF_LRA) ; Quantifier-free LRA

; After setting logic, appropriate functions become available
(declare-const x Int)
(declare-const y Int)

; Integer arithmetic (available in LIA logics)
(assert (= (+ x y) 0))
(assert (<= x y))

; Real arithmetic (available in LRA logics)
(declare-const r Real)
(assert (= (+ r 1.0) 2.0))
