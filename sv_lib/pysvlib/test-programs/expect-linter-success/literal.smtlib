(set-logic LIA)

; Valid literals of different types
(assert (= 42 42))           ; Integer literal
(assert (= 3.14 3.14))       ; Real literal
(assert true)                ; Boolean literal

; Literals in expressions
(declare-const x Int)
(assert (= x 0))
(assert (= (+ x 1) 1))
