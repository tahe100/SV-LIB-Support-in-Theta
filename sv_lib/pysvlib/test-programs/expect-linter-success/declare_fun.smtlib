(set-logic LIA)

; Valid function declarations with different signatures
(declare-fun identity (Int) Int)
(declare-fun add (Int Int) Int)
(declare-fun is_even (Int) Bool)
(declare-fun combine (Bool Real) Real)

; Functions can be used in expressions (though not defined)
(declare-const x Int)
(declare-const y Int)
(assert (= (identity x) x))
(assert (= (add x y) (+ x y)))
