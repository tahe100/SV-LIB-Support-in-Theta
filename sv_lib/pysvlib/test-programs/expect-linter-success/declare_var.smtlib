(set-logic LIA)

; Valid variable declarations with different sorts
(declare-const x Int)
(declare-const y Int)
(declare-const flag Bool)
(declare-const value Real)

; Variables can be used in expressions
(assert (= (+ x y) 10))
(assert (and flag (= value 3.14)))
