(set-logic QF_BV)

(define-proc
    main
    ()
    ((s (_ BitVec 3)))
    ((s_next (_ BitVec 3)))
    (! (sequence
        (assign (s (_ bv0 3)))
        (! (sequence ) :tag  system-main-check-before-loop)
        (! (while true
            (! (sequence
                (assign (s_next (bvadd s (_ bv2 3))))
                (assign (s s_next))
                (! (sequence ) :tag system-main-check)
            )
            :tag while-body)
           )
        :tag while-loop :invariant true)
    )
    :tag proc-0)
)

(annotate-tag
     system-main-check-before-loop
    :check-true (= (bvurem s (_ bv2 3)) (_ bv1 3))
)

(annotate-tag
    system-main-check
    :check-true (= (bvurem s (_ bv2 3)) (_ bv1 3))
)


(verify-call main ())
(get-witness)
