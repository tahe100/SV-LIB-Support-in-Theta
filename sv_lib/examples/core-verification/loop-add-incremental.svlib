(set-logic LIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")

(define-proc
  add
  ((x0 Int) (y0 Int))
  ((x Int))
  ((y Int))
  (! (sequence
        (assign (x x0) (y y0))
        (! (while
             (< 0 y)
             (assign
               (x (+ x 1))
               (y (- y 1))))
          :tag while-loop))
    :tag proc-add))

(annotate-tag
    proc-add
    :requires (<= 0 y0)
    :ensures  (= x (+ x0 y0)))

(annotate-tag while-loop :not-recurring)

(declare-const x1 Int)
(declare-const y1 Int)

(verify-call add (x1 y1))

(define-proc
  mul
  ((x2 Int) (y2 Int))
  ((m Int))
  ((l Int))
  (! (sequence
       (assign (m x2) (l y2))
       (! (while
            (< 0 l)
            (sequence
              (call add (m x2) (m))
              (assign (l (- l 1)))))
        :tag while-mul))
  :tag proc-mul))

(annotate-tag
    proc-mul
    :requires (<= 0 y2)
    :ensures  (= m (* x2 y2)))

(verify-call mul (x1 y1))
(get-witness)
