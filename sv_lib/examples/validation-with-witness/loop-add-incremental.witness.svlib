; Annotations for the first verify-call
((annotate-tag
    while-1
    :invariant
        (and
            (<= 0 y)
            (= (+ x y) (+ x0 y0)))))

; Annotations for the second verify-call
((annotate-tag
    while-2
    :invariant
        (and
            (<= 0 y)
            (= (* x0 y0) (+ x (* x0 y))))))