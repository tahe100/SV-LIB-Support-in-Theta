(set-logic NIA)

(set-option :produce-witnesses true)

(set-info :format-version "1.0")


(define-proc
    add
    ((x0 Int) (y0 Int))
    ((x Int))
    ((y Int))
    (!
        (sequence
            (assign (x x0) (y y0))
            (!
                (while
                    (< 0 y)
                    (assign
                        (x (+ x 1))
                        (y (- y 1))))
                :tag while-1))
        :tag proc-add))

(define-proc
    mul
    ((x0 Int) (y0 Int))
    ((x Int))
    ((y Int))
    (!
        (sequence
            (assign (x 0) (y y0))
            (!
                (while
                    (< 0 y)
                    (sequence
                        (call add (x x0) (x))
                        (assign (y (- y 1)))))
                :tag while-2))
        :tag proc-mul))

(annotate-tag
    proc-add
    :requires (<= 0 y0)
    :ensures  (= x (+ x0 y0)))

(annotate-tag
    proc-mul
    :requires (and (<= 0 x0) (<= 0 y0))
    :ensures  (= x (* x0 y0)))

(annotate-tag
    while-1
    :invariant
        (and
            (<= 0 y)
            (= (+ x y) (+ x0 y0))))

(annotate-tag
    while-2
    :invariant
        (and
            (<= 0 y)
            (= (* x0 y0) (+ x (* x0 y)))))

(declare-const x0 Int)
(declare-const y0 Int)

(assert (<= 0 x0))
(assert (<= 0 y0))

(verify-call
    mul (x0 y0))

(get-witness)